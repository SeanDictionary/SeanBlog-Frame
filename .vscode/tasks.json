{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: next",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "db: migrate deploy",
      "type": "shell",
      "command": "$pgEnv = docker inspect \"seanblog-dev-db\" --format \"{{json .Config.Env}}\" | ConvertFrom-Json; $pgPassword = ($pgEnv | Where-Object { $_ -like 'POSTGRES_PASSWORD=*' }) -replace '^POSTGRES_PASSWORD=', ''; $env:DATABASE_URL = \"postgresql://postgres:$pgPassword@localhost:5432/seanblog_frame?schema=public\"; npx prisma migrate deploy",
      "options": {
        "shell": {
          "executable": "pwsh",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "db: seed",
      "type": "shell",
      "command": "$pgEnv = docker inspect \"seanblog-dev-db\" --format \"{{json .Config.Env}}\" | ConvertFrom-Json; $pgPassword = ($pgEnv | Where-Object { $_ -like 'POSTGRES_PASSWORD=*' }) -replace '^POSTGRES_PASSWORD=', ''; $env:DATABASE_URL = \"postgresql://postgres:$pgPassword@localhost:5432/seanblog_frame?schema=public\"; npm run db:seed",
      "options": {
        "shell": {
          "executable": "pwsh",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "check: typecheck",
      "type": "npm",
      "script": "typecheck",
