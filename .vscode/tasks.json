        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "check: prisma validate",
      "type": "shell",
      "command": "npx prisma validate",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "check: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "check: backend",
      "dependsOrder": "sequence",
      "dependsOn": [
        "check: prisma validate",
        "check: typecheck",
        "check: build"
      ],
      "problemMatcher": []
    }
  ]
