{
  "slug": "cardinal",
  "name": "Cardinal",
  "version": "3.0.0",
  "author": "SeanBlog Frame",
  "description": "高自由度可配置主题，支持侧边栏位置、顶部栏、列表样式、Hero区、字体、色彩模式等 15 项设置。灵感来自 Aurora0x27 + DexterJie + Lazzaro + Yo1o。",
  "engine": "seanblog-theme",
  "engineVersion": 1,
  "assets": {
    "css": "assets/theme.css"
  },
  "templates": {
    "home": "templates/home.json",
    "articleList": "templates/article-list.json",
    "articleDetail": "templates/article-detail.json",
    "taxonomy": "templates/taxonomy.json",
    "search": "templates/search.json"
  },
  "parts": {
    "header": "parts/header.json",
    "footer": "parts/footer.json"
  },
  "settingsSchema": [
    {
      "key": "sidebarPosition",
      "label": "侧边栏位置",
      "type": "select",
      "options": [
        {
          "value": "none",
          "label": "无侧边栏"
        },
        {
          "value": "left",
          "label": "左侧"
        },
        {
          "value": "right",
          "label": "右侧"
        },
        {
          "value": "both",
          "label": "双侧"
        }
      ],
      "default": "right",
      "group": "布局结构",
      "description": "控制侧边栏出现位置，none=无侧边栏，left/right=单侧，both=双侧"
    },
    {
      "key": "showTopBar",
      "label": "显示顶部栏",
      "type": "boolean",
      "default": true,
      "group": "布局结构",
      "description": "是否显示顶部导航栏。关闭后品牌和导航移入侧边栏"
    },
    {
      "key": "articleListStyle",
      "label": "文章列表样式",
      "type": "select",
      "options": [
        {
          "value": "list",
          "label": "文字列表"
        },
        {
          "value": "cards",
          "label": "卡片网格"
        }
      ],
      "default": "list",
      "group": "布局结构",
      "description": "文章列表的排列方式：文字列表或卡片网格"
    },
    {
      "key": "showHeroSection",
      "label": "首页 Hero 区",
      "type": "boolean",
      "default": true,
      "group": "布局结构",
      "description": "首页顶部是否显示站点名称和介绍区域"
    },
    {
      "key": "showFeaturedSection",
      "label": "精选文章区",
      "type": "boolean",
      "default": false,
      "group": "布局结构",
      "description": "首页是否拆分精选置顶文章和最新文章两个区块"
    },
    {
      "key": "contentWidth",
      "label": "内容宽度",
      "type": "select",
      "options": [
        {
          "value": "narrow",
          "label": "窄 (30rem)"
        },
        {
          "value": "medium",
          "label": "中 (42rem)"
        },
        {
          "value": "wide",
          "label": "宽 (64rem)"
        }
      ],
      "default": "medium",
      "group": "布局结构",
      "description": "正文内容区域的最大宽度：窄30rem、中42rem、宽64rem"
    },
    {
      "key": "sidebarSticky",
      "label": "侧边栏固定",
      "type": "select",
      "options": [
        {
          "value": "static",
          "label": "不固定"
        },
        {
          "value": "sticky",
          "label": "滚动吸顶"
        },
        {
          "value": "fixed",
          "label": "全屏固定"
        }
      ],
      "default": "sticky",
      "group": "布局结构",
      "description": "侧边栏跟随方式：不固定、滚动吸顶、全屏固定（Lazzaro风格）"
    },
    {
      "key": "sidebarContent",
      "label": "侧边栏内容",
      "type": "multiselect",
      "options": [
        {
          "value": "profile",
          "label": "个人简介"
        },
        {
          "value": "recent",
          "label": "最近文章"
        },
        {
          "value": "tags",
          "label": "标签云"
        },
        {
          "value": "categories",
          "label": "分类列表"
        },
        {
          "value": "toc",
          "label": "文章目录"
        }
      ],
      "default": [
        "profile",
        "recent",
        "tags"
      ],
      "group": "布局结构",
      "description": "选择侧边栏显示的内容区块，顺序即渲染顺序"
    },
    {
      "key": "fontFamily",
      "label": "正文字体",
      "type": "select",
      "options": [
        {
          "value": "monospace",
          "label": "等宽 (Monospace)"
        },
        {
          "value": "sans",
          "label": "无衬线 (Sans)"
        },
        {
          "value": "serif",
          "label": "衬线 (Serif)"
        }
      ],
      "default": "monospace",
      "group": "视觉风格",
      "description": "全局正文字体族"
    },
    {
      "key": "headingFontFamily",
      "label": "标题字体",
      "type": "select",
      "options": [
        {
          "value": "same",
          "label": "跟随正文"
        },
        {
          "value": "monospace",
          "label": "等宽"
        },
        {
          "value": "sans",
          "label": "无衬线"
        },
        {
          "value": "serif",
          "label": "衬线"
        }
      ],
      "default": "same",
      "group": "视觉风格",
      "description": "标题字体族，跟随正文则与正文字体一致"
    },
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#cf829e",
      "cssVariable": "--color-accent",
      "group": "视觉风格",
      "description": "链接、悬停、强调色。与暗色/浅色模式搭配使用"
    },
    {
      "key": "colorMode",
      "label": "色彩模式",
      "type": "select",
      "options": [
        {
          "value": "dark",
          "label": "深色"
        },
        {
          "value": "light",
          "label": "浅色"
        },
        {
          "value": "auto",
          "label": "跟随系统"
        }
      ],
      "default": "dark",
      "group": "视觉风格",
      "description": "默认色彩模式。用户可通过切换按钮覆盖此设置"
    },
    {
      "key": "showThemeToggle",
      "label": "前台色彩切换按钮",
      "type": "boolean",
      "default": true,
      "group": "视觉风格",
      "description": "是否在前台显示深浅色切换按钮。关闭后仅按后台设置显示"
    },
    {
      "key": "borderRadius",
      "label": "圆角大小",
      "type": "select",
      "options": [
        {
          "value": "none",
          "label": "无圆角"
        },
        {
          "value": "small",
          "label": "小"
        },
        {
          "value": "medium",
          "label": "中"
        },
        {
          "value": "large",
          "label": "大"
        }
      ],
      "default": "small",
      "group": "视觉风格",
      "description": "卡片和面板的圆角大小"
    },
    {
      "key": "showShadow",
      "label": "阴影效果",
      "type": "boolean",
      "default": false,
      "group": "视觉风格",
      "description": "卡片和面板是否使用阴影效果"
    },
    {
      "key": "listSeparator",
      "label": "列表分隔方式",
      "type": "select",
      "options": [
        {
          "value": "border",
          "label": "底线分隔"
        },
        {
          "value": "gap",
          "label": "间距分隔"
        },
        {
          "value": "card",
          "label": "卡片包裹"
        }
      ],
      "default": "border",
      "group": "视觉风格",
      "description": "文章列表项之间的分隔方式：底线、间距或卡片包裹"
    }
  ],
  "blocks": [
    "SiteHeader",
    "ArticleList",
    "ArticleCard",
    "ArticleContent",
    "TaxonomyList",
    "Pagination",
    "SearchDialog",
    "CommentList",
    "SiteFooter"
  ]
}
