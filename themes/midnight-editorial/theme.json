{
  "slug": "midnight-editorial",
  "name": "Midnight Editorial",
  "version": "1.0.0",
  "author": "SeanBlog Frame",
  "description": "暗色杂志风主题，暖色调深色背景、衬线标题、厚边框、窄圆角，适合长文阅读和编辑风格博客。",
  "engine": "seanblog-theme",
  "engineVersion": 1,
  "assets": {
    "css": "assets/theme.css"
  },
  "templates": {
    "home": "templates/home.json",
    "articleList": "templates/article-list.json",
    "articleDetail": "templates/article-detail.json",
    "taxonomy": "templates/taxonomy.json",
    "search": "templates/search.json"
  },
  "parts": {
    "header": "parts/header.json",
    "footer": "parts/footer.json"
  },
  "settingsSchema": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#f59e0b",
      "cssVariable": "--color-accent"
    },
    {
      "key": "contentMaxWidth",
      "label": "内容宽度",
      "type": "text",
      "default": "44rem",
      "cssVariable": "--content-max-width"
    },
    {
      "key": "radius",
      "label": "圆角",
      "type": "text",
      "default": "0.125rem",
      "cssVariable": "--radius"
    },
    {
      "key": "headerHeight",
      "label": "Header 高度",
      "type": "text",
      "default": "5rem",
      "cssVariable": "--header-height"
    },
    {
      "key": "sidebarTitle",
      "label": "侧栏标题",
      "type": "text",
      "default": "Recent"
    },
    {
      "key": "cardStyle",
      "label": "卡片风格",
      "type": "select",
      "default": "bordered",
      "options": [
        { "label": "厚边框", "value": "bordered" },
        { "label": "阴影浮起", "value": "shadow" },
        { "label": "极简", "value": "minimal" }
      ]
    },
    {
      "key": "dockLinks",
      "label": "Dock 链接",
      "type": "list",
      "itemFields": [
        { "key": "label", "label": "标签", "type": "text" },
        { "key": "href", "label": "链接", "type": "text" },
        { "key": "icon", "label": "图标", "type": "text" }
      ]
    }
  ],
  "blocks": [
    "SiteHeader",
    "ArticleList",
    "ArticleCard",
    "ArticleContent",
    "TaxonomyList",
    "Pagination",
    "SearchDialog",
    "CommentList",
    "SiteFooter"
  ]
}
